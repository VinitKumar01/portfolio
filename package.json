{
  "name": "vinit-portfolio-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.11.7",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.0"
}
